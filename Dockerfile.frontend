FROM node:22-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_945_API_MODE=http
ARG VITE_945_API_BASE_URL=
ARG VITE_945_AUTH_ENABLED=true
ENV VITE_945_API_MODE=$VITE_945_API_MODE
ENV VITE_945_API_BASE_URL=$VITE_945_API_BASE_URL
ENV VITE_945_AUTH_ENABLED=$VITE_945_AUTH_ENABLED
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
